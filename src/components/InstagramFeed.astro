---
import { site, instagram } from '../data/site.js';
import { instagramPosts, instagramIsLive } from '../data/instagram.js';
---

<section id="instagram">
  <div class="wrap">
    <div class="cms rv">
      <div class="cms-copy">
        <span class="eyebrow mono">{instagram.eyebrow}</span>
        <h3>{instagram.heading}</h3>
        <p>{instagram.body}</p>
        <ul class="cms-list">
          {instagram.points.map((point) => (
            <li><span class="check">&#10022;</span><span>{point}</span></li>
          ))}
        </ul>
        <p style="margin:26px 0 0">
          <a href={site.instagramUrl} class="btn btn-primary" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
              <circle cx="12" cy="12" r="4.2"></circle>
              <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"></circle>
            </svg>
            Follow @{site.instagram}
          </a>
        </p>
      </div>

      <div class="ig-panel">
        <div class="ig-head">
          <span class="ig-handle">
            <span class="ig-avatar" aria-hidden="true"></span>
            @{site.instagram}
          </span>
          <a href={site.instagramUrl} class="ig-view" rel="noopener">View profile &rarr;</a>
        </div>

        <div class="ig-grid">
          {instagramPosts.map((post) => (
            <a
              class="ig-tile"
              href={post.permalink}
              rel="noopener"
              aria-label={post.alt}
              data-tone={post.tone ?? undefined}
            >
              {post.image ? (
                <img src={post.image} alt={post.alt} loading="lazy" decoding="async" width="300" height="300" />
              ) : (
                <span class="ig-placeholder" aria-hidden="true"></span>
              )}
              {post.isVideo && (
                <span class="ig-play" aria-hidden="true">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
                </span>
              )}
              <span class="ig-hover" aria-hidden="true"></span>
            </a>
          ))}
        </div>

        {!instagramIsLive && (
          <p class="ig-note">Live feed not connected yet &mdash; see INSTAGRAM.md</p>
        )}
      </div>
    </div>
  </div>
</section>
